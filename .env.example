# P2P Share — environment configuration (copy to .env; never commit real secrets)
# The server only. Browsers fetch short-lived ICE config from GET /api/ice.

# Port the app listens on (hosting platforms set this automatically).
PORT=3000

# TURN server URLs, comma-separated, UDP-first for best speed. Examples:
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:443?transport=tcp
# Leave empty to run STUN-only (fine on LAN / easy NATs).
TURN_URLS=

# Option A — static credentials (managed TURN without REST support).
TURN_USER=
TURN_PASS=

# Option B — coturn shared secret (use-auth-secret / static-auth-secret).
# Enables time-limited credentials: username "<expiry>:<random>",
# password base64(HMAC-SHA1(secret, username)). Preferred when available.
# Mutually exclusive with A: if TURN_SECRET is set, it wins.
TURN_SECRET=
TURN_REALM=p2p-share
# Credential lifetime in seconds (60–86400).
TURN_TTL=3600
